# Server
PORT=2817
APP_ENV=development
LOG_LEVEL=debug

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname
# Keep TLS verification enabled in production. Set to false only for local dev.
DB_SSL_REJECT_UNAUTHORIZED=true

# JWT 
JWT_SECRET=change-me
JWT_EXPIRE=24h

# Cloudflare R2
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=porto-ditdev
R2_PUBLIC_URL=https://cdn.kyuzenstudio.site

# AI Chat
XKIRO_API_KEY=change-me
XKIRO_MODEL=deepseek/deepseek-v4-flash
CEREBRAS_API_KEY=change-me
CEREBRAS_MODEL=gpt-5.5
RAG_SERVICE_URL=http://localhost:8765
# Only needed when the RAG service is not on localhost: it then rejects unsigned
# /index/* writes. Must match RAG_API_SECRET on the RAG service side.
RAG_API_SECRET=
# Must match RAG_REBUILD_SECRET on the RAG service side. Leave empty to disable
# the admin panel's rebuild button (a rebuild drops the index before re-embedding).
RAG_REBUILD_SECRET=

# Contact 
DISCORD_WEBHOOK_URL=change-me

# GitHub activity proxy
GITHUB_USERNAME=rillToMe
# Optional: personal access token (no scopes) to raise the rate limit to 5000/hr
GITHUB_TOKEN=

# CORS
CLIENT_URL=https://ditdev.kyuzenstudio.com
ADMIN_URL=http://localhost:3000
